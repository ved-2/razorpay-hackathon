{
  "manifest_version": 3,
  "name": "CommerceOS — Autonomous AI Buyer",
  "version": "1.0.0",
  "description": "Voice-enabled autonomous AI buyer agent powered by CommerceOS and Groq LPUs",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://localhost:4000/*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "CommerceOS AI Buyer"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:3000/*"],
      "js": ["content/auth-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "exclude_matches": ["http://localhost:3000/login*"],
      "js": ["content/product-scraper.js"],
      "run_at": "document_idle"
    }
  ]
}
